# Routine project inspection and verification.
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["awk"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["python3", "-m", "unittest"], decision="allow")
prefix_rule(pattern=["python3", "-m", "py_compile"], decision="allow")
prefix_rule(pattern=["bash", "-n"], decision="allow")
prefix_rule(pattern=["omarchy", "plugin", "validate"], decision="allow")
prefix_rule(pattern=["git", "diff", "--check"], decision="allow")
prefix_rule(pattern=["qmltestrunner"], decision="allow")

# These operations can change dependencies, machine state, or external state.
prefix_rule(pattern=["pip", "install"], decision="prompt", justification="Installing dependencies changes the environment")
prefix_rule(pattern=["pip3", "install"], decision="prompt", justification="Installing dependencies changes the environment")
prefix_rule(pattern=["python3", "-m", "pip", "install"], decision="prompt", justification="Installing dependencies changes the environment")
prefix_rule(pattern=["curl"], decision="prompt", justification="Network access is approval-gated for this project")
prefix_rule(pattern=["wget"], decision="prompt", justification="Network access is approval-gated for this project")
prefix_rule(pattern=["git", "fetch"], decision="prompt", justification="Fetching changes uses the network")
prefix_rule(pattern=["git", "pull"], decision="prompt", justification="Pulling changes uses the network and modifies the worktree")
prefix_rule(pattern=["git", "push"], decision="prompt", justification="Pushing publishes repository state")
prefix_rule(pattern=["omarchy", "restart"], decision="prompt", justification="Restarting Omarchy changes live system state")

# Broad destructive operations are forbidden by default.
prefix_rule(pattern=["git", "reset", "--hard"], decision="forbidden", justification="Use targeted, recoverable changes instead")
prefix_rule(pattern=["git", "clean"], decision="forbidden", justification="Do not broadly delete untracked work")
prefix_rule(pattern=["jj", "abandon"], decision="forbidden", justification="Do not rewrite or abandon history implicitly")
